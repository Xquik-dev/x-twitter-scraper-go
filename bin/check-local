#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik contributors
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail

readonly status_repo="Xquik-dev/x-twitter-scraper-go"
readonly status_context="xquik-local-checks"
readonly reuse_version="6.2.0"

post_status=true
for arg in "$@"; do
  case "$arg" in
    --no-status) post_status=false ;;
    *)
      printf 'Unknown option %s. Run bin/check-local or bin/check-local --no-status.\n' "$arg" >&2
      exit 2
      ;;
  esac
done

cd "$(dirname "$0")/.."

fuzz_time="${FUZZ_TIME:-15s}"
sha="$(git rev-parse HEAD)"
current=""
passed=""

if [[ "$post_status" == true ]]; then
  skip_reason=""
  if ! command -v gh >/dev/null 2>&1; then
    skip_reason="GitHub CLI is not installed"
  elif [[ -n "$(git status --porcelain)" ]]; then
    skip_reason="the working tree has uncommitted changes"
  elif ! gh api --silent "repos/$status_repo/commits/$sha" >/dev/null 2>&1; then
    skip_reason="GitHub does not show commit ${sha:0:12}. Push it, or run gh auth login"
  fi
  if [[ -n "$skip_reason" ]]; then
    printf '==> Not posting the %s status because %s.\n' "$status_context" "$skip_reason"
    post_status=false
  fi
fi

post() {
  [[ "$post_status" == true ]] || return 0
  local description="${2:0:139}" error="" attempt
  for attempt in 1 2 3; do
    if error="$(gh api --silent "repos/$status_repo/statuses/$sha" \
      -f state="$1" -f context="$status_context" -f description="$description" 2>&1)"; then
      return 0
    fi
    if ((attempt < 3)); then
      sleep 5
    fi
  done
  printf '==> Could not post the %s status. GitHub CLI said %s\n' "$status_context" "${error//$'\n'/ }" >&2
}

source scripts/temp-paths
temp_path work check-local

finish() {
  local code=$?
  remove_temp_paths
  if ((code == 0)); then
    local list="$passed"
    if [[ "$list" == *", "* ]]; then
      list="${list%, *} & ${list##*, }"
    fi
    post success "Passed $list."
  elif [[ -n "$current" ]]; then
    post failure "Failed at $current. Run bin/check-local for details."
  else
    post failure "Stopped before the first check. Run bin/check-local for details."
  fi
  exit "$code"
}
trap finish EXIT

post pending "bin/check-local is running."

current="Find tools"
for tool in go jq uv; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf 'Check failed because %s is missing. Install it with brew install %s, then run bin/check-local again.\n' \
      "$tool" "$tool" >&2
    exit 1
  fi
done

run() {
  local label="$1" name="$2" fix="$3"
  shift 3
  current="$name"
  printf '==> %s\n' "$name"
  if ! "$@"; then
    printf 'Check failed at %s. %s\n' "$name" "$fix" >&2
    exit 1
  fi
  [[ -z "$label" ]] || passed="${passed:+$passed, }$label"
}

coverage_against_parent() {
  local parent common
  parent="HEAD^"
  [[ -z "$(git status --porcelain)" ]] || parent="HEAD"
  parent="$(git rev-parse --verify "$parent")"
  common="$(git rev-parse --path-format=absolute --git-common-dir)"
  if [[ ! -f "$common/coverage-baselines/$parent/report.json" ]]; then
    scripts/coverage-baseline "$parent" || return 1
  fi
  go run ./cmd/coverage-gain "$XQUIK_COVERAGE_DIR"
}

audit() {
  scripts/dependency-audit | tee "$work/audit.log"
}

audit_label() {
  local exceptions
  exceptions="$(sed -nE 's/^Dependency audit passed with ([0-9]+) reviewed exceptions?\.$/\1/p' "$work/audit.log")"
  case "$exceptions" in
    "") printf 'audit' ;;
    1) printf 'audit with 1 reviewed exception' ;;
    *) printf 'audit with %s reviewed exceptions' "$exceptions" ;;
  esac
}

export XQUIK_COVERAGE_DIR="$work/coverage"
mkdir "$XQUIK_COVERAGE_DIR"

run "API coverage" "API coverage" "Follow the lines above, then run bin/check-local again." go run ./cmd/api-coverage
run "API fields" "API fields" "Follow the lines above, then run bin/check-local again." go run ./cmd/api-fields
run modules "Module integrity" "Run go clean -modcache, then retry." go mod verify
run lint "Lint" "Run scripts/format, then fix the go vet findings above." scripts/lint
run REUSE "REUSE licensing" "Add the missing license notice or REUSE.toml entry." \
  uvx --from "reuse==$reuse_version" reuse lint
run tests "Tests" "Fix the failing tests above." scripts/test
run "" "Statement coverage" "Fix the failing tests above." scripts/collect-coverage
run "" "Branch coverage" "Fix the failing tests above." scripts/collect-branches
run "coverage vs parent" "Coverage against the parent" "Add tests so no coverage metric falls below the parent's." \
  coverage_against_parent
run race "Race detector" "Fix the data race reported above." go test -race ./...
run audit "Dependency audit" "Fix each blocked finding above, or review audit-exceptions.json." audit
passed="${passed%audit}$(audit_label)"
run "signing audit" "Signing tool audit" "Update the locked dependency in tools/signing, then rerun." \
  bash scripts/signing-audit
run "source scan" "Source scan" "Fix each gosec finding above." \
  scripts/source-security
run archive "Reproducible module archive" "Remove the build input that differs between the archives." \
  scripts/reproducible-build
run CodeQL "CodeQL" "Install CodeQL 2.27.2 as CONTRIBUTING.md says, or fix the findings above." \
  scripts/codeql-security
run "fuzz $fuzz_time" "Fuzzing" "Fix the crash. Go saved its input under internal/apiform/testdata/fuzz." \
  go test ./internal/apiform -run '^$' -fuzz '^FuzzMarshalRoundTrip$' -fuzztime="$fuzz_time"

current=""
printf 'All checks passed.\n'
