#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik contributors
# SPDX-License-Identifier: Apache-2.0
#
# Runs the checks that GitHub Actions used to run, in the same order.
# Stops at the first failure and says what to do next.
# When HEAD is clean and on GitHub, posts the xquik-local-checks commit status
# through the GitHub CLI login of whoever runs it. On the release machine, that
# is the owner's gh login. The status lists only the checks that ran and passed,
# and it says success only after every required check passed.
# --no-status skips the commit status.
# FUZZ_TIME sets the fuzzing time. The default is 15s; use 2m for a full campaign.
set -euo pipefail

readonly status_repo="Xquik-dev/x-twitter-scraper-go"
readonly status_context="xquik-local-checks"

post_status=true
for arg in "$@"; do
  case "$arg" in
    --no-status) post_status=false ;;
    *)
      printf 'check-local: unknown option %s. Use --no-status or no option.\n' "$arg" >&2
      exit 2
      ;;
  esac
done

cd "$(dirname "$0")/.."

fuzz_time="${FUZZ_TIME:-15s}"
sha="$(git rev-parse HEAD)"
current=""
checks_passed=0
passed=""
skipped=""

if [[ "$post_status" == true ]]; then
  skip_reason=""
  if ! command -v gh >/dev/null 2>&1; then
    skip_reason="GitHub CLI is not installed"
  elif [[ -n "$(git status --porcelain)" ]]; then
    skip_reason="the working tree has uncommitted changes"
  elif ! gh api --silent "repos/$status_repo/commits/$sha" >/dev/null 2>&1; then
    skip_reason="GitHub does not show commit ${sha:0:12}; push it or run gh auth login"
  fi
  if [[ -n "$skip_reason" ]]; then
    printf '==> Not posting the %s status: %s.\n' "$status_context" "$skip_reason"
    post_status=false
  fi
fi

post() {
  [[ "$post_status" == true ]] || return 0
  local description="${2:0:139}"
  gh api --silent "repos/$status_repo/statuses/$sha" \
    -f state="$1" -f context="$status_context" -f description="$description" >/dev/null 2>&1 ||
    printf '==> Could not post the %s status. Run gh auth status.\n' "$status_context" >&2
}

finish() {
  local code=$?
  if ((code == 0)); then
    local go_version list="$passed"
    go_version="$(go env GOVERSION 2>/dev/null || true)"
    if [[ "$list" == *", "* ]]; then
      list="${list%, *} & ${list##*, }"
    fi
    post success "Passed on ${go_version:-Go}: $list${skipped:+; skipped $skipped}"
  elif [[ -n "$current" ]]; then
    post failure "$current failed after $checks_passed passed checks. Run bin/check-local for details."
  else
    post failure "check-local stopped before its first check. Run bin/check-local for details."
  fi
  exit "$code"
}
trap finish EXIT

post pending "bin/check-local is running."

run() {
  local label="$1" name="$2" fix="$3"
  shift 3
  current="$name"
  printf '==> %s\n' "$name"
  if ! "$@"; then
    printf 'check-local: %s failed. %s\n' "$name" "$fix" >&2
    exit 1
  fi
  checks_passed=$((checks_passed + 1))
  passed="${passed:+$passed, }$label"
}

reuse_lint() {
  if command -v reuse >/dev/null 2>&1; then
    reuse lint
  else
    uvx --from reuse==5.1.1 reuse lint
  fi
}

run modules "Module integrity" "Run go clean -modcache, then retry." go mod verify
run lint "Lint" "Run scripts/format, then fix the go vet findings above." scripts/lint
if command -v reuse >/dev/null 2>&1 || command -v uvx >/dev/null 2>&1; then
  run REUSE "REUSE licensing" "Add the missing license data to REUSE.toml." reuse_lint
else
  printf '==> Skipping REUSE licensing: install reuse or uv to run it.\n'
  skipped="REUSE"
fi
run tests "Tests" "Fix the failing tests above." scripts/test
run coverage "Statement coverage" "Fix the failing tests above." scripts/collect-coverage
run branches "Branch coverage" "Fix the failing tests above." scripts/collect-branches
run race "Race detector" "Fix the data race reported above." go test -race ./...
run audit "Dependency audit" "Upgrade the module or Go version above, or review audit-exceptions.json." \
  scripts/dependency-audit
run archive "Reproducible module archive" "Remove the build input that differs between the archives." \
  scripts/reproducible-build
run CodeQL "CodeQL" "Install CodeQL 2.27.0 as CONTRIBUTING.md says, or fix the findings above." \
  scripts/codeql-security
run "fuzz $fuzz_time" "Fuzzing" "Fix the crash. Go saved its input under internal/apiform/testdata/fuzz." \
  go test ./internal/apiform -run '^$' -fuzz '^FuzzMarshalRoundTrip$' -fuzztime="$fuzz_time"

current=""
printf 'All checks passed.\n'
