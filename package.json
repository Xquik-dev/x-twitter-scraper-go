{
  "private": true,
  "scripts": {
    "check:all": "./scripts/check-all",
    "check:lint": "./scripts/lint",
    "check:tests": "./scripts/test",
    "check:race": "go test -race ./...",
    "check:fuzz": "go test ./internal/apiform -run '^$' -fuzz '^FuzzMarshalRoundTrip$' -fuzztime=2m",
    "check:security": "go run golang.org/x/vuln/cmd/govulncheck@v1.6.0 ./...",
    "check:source-security": "./scripts/source-security",
    "check:licenses": "bash scripts/licenses.sh lint",
    "build": "go build ./... && ./scripts/reproducible-build",
    "report:coverage": "./scripts/collect-coverage",
    "report:branches": "./scripts/collect-branches",
    "install:licenses": "bash scripts/licenses.sh install",
    "check:codeql": "./scripts/codeql-security",
    "release:verify": "bash scripts/verify-release",
    "release:prepare": "bash scripts/release prepare",
    "release:publish": "bash scripts/release publish",
    "check:signing-security": "bash scripts/signing-audit"
  },
  "config": {
    "cargoAudit": "0.22.2",
