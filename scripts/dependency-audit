#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik contributors
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail

source "$(dirname "$0")/temp-paths"
cd "${1:-$(dirname "$0")/..}"

readonly govulncheck="golang.org/x/vuln/cmd/govulncheck@v1.9.0"
temp_path workspace -d "${TMPDIR:-/tmp}/xquik-govulncheck.XXXXXX"
export GOTMPDIR="$workspace"
report="$workspace/report.json"

packages="$(go list -f '{{if and (ne .Name "main") .GoFiles}}{{.ImportPath}}{{end}}' ./...)"
importable=()
while IFS= read -r package; do
  if [[ -n "$package" && "$package" != */internal/* && "$package" != */internal ]]; then
    importable+=("$package")
  fi
done <<<"$packages"
if ((${#importable[@]} == 0)); then
  printf 'Found no package that callers can import. Run go list ./... to see why.\n' >&2
  exit 1
fi
shipped="$(go list -deps -f '{{with .Module}}{{.Path}}{{end}}' "${importable[@]}")"

go run "$govulncheck" -format json -test ./... >"$report"

verdicts="$(jq -nr --slurpfile exceptions audit-exceptions.json --arg shipped "$shipped" '
  def day($offset): now + $offset * 86400 | strftime("%Y-%m-%d");
  day(0) as $today
  | day(30) as $limit
  | ["build-time only", "peer dependency provided by the host"] as $reasons
  | ($shipped | split("\n") | map(select(. != "")) + ["stdlib"] | unique) as $ships
  | $exceptions[0] as $listed
  | ([inputs | .finding? | select(. != null)
      | {id: .osv, module: .trace[0].module, fixed: (.fixed_version // "")}] | unique) as $findings
  | def flaw:
      if (.reason | IN($reasons[]) | not) then
        "needs a \"reason\" of \"" + ($reasons | join("\" or \"")) + "\"."
      elif (.recheck | type) != "string" or (.recheck | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") | not) then
        "needs a \"recheck\" date like \($limit)."
      elif .recheck <= $today then
        "expired on \(.recheck). Recheck the finding."
      elif .recheck > $limit then
        "rechecks on \(.recheck). Use \($limit) or earlier."
      else
        empty
      end;
    if ($listed | type) != "array"
      or any($listed[]; type != "object" or (.id | type) != "string" or (.module | type) != "string")
    then
      "Blocked. audit-exceptions.json must hold an array of entries with \"id\", \"module\", \"reason\" and \"recheck\"."
    else
      ($listed[] | "Blocked. The exception for \(.id) in \(.module) " + flaw),
      ($findings[]
        | . as $finding
        | [$listed[] | select(.id == $finding.id and .module == $finding.module)] as $entries
        | if any($ships[]; . == $finding.module) then
            "Blocked. \($finding.id) is in \($finding.module), which ships to callers. "
            + (if $finding.fixed != "" then "Upgrade to \($finding.fixed)." else "It has no fix yet, so replace the module." end)
            + (if ($entries | length) > 0 then " Remove its audit-exceptions.json entry." else "" end)
          elif $finding.fixed != "" then
            "Blocked. \($finding.id) in \($finding.module) is fixed in \($finding.fixed). Upgrade it."
          elif ($entries | length) == 0 then
            "Blocked. \($finding.id) in \($finding.module) has no fix. Review it and list it in audit-exceptions.json."
          elif any($entries[]; [flaw] | length == 0) then
            "Accepted the reviewed exception for \($finding.id) in \($finding.module)."
          else
            empty
          end),
      ($listed[]
        | . as $entry
        | select(any($findings[]; .id == $entry.id and .module == $entry.module and .fixed == "") | not)
        | "audit-exceptions.json lists \(.id) for \(.module), which no longer applies. Remove it.")
    end
' "$report")"

if [[ -n "$verdicts" ]]; then
  printf '%s\n' "$verdicts"
fi
blocked="$(grep -c '^Blocked\. ' <<<"$verdicts" || true)"
if ((blocked > 0)); then
  printf 'Dependency audit failed with %d blocking finding(s). For call traces, run go run %s -test ./...\n' \
    "$blocked" "$govulncheck" >&2
  exit 1
fi
accepted="$(grep -c '^Accepted ' <<<"$verdicts" || true)"
case "$accepted" in
  0) printf 'Dependency audit passed.\n' ;;
  1) printf 'Dependency audit passed with 1 reviewed exception.\n' ;;
  *) printf 'Dependency audit passed with %d reviewed exceptions.\n' "$accepted" ;;
esac
