#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik contributors
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
cd "$(dirname "$0")/.."
revision="$(git rev-parse --verify "${1:?Run scripts/coverage-baseline <revision>.}^{commit}")"
workspace="$(mktemp -d "${TMPDIR:-/tmp}/xquik-coverage-baseline.XXXXXX")"
trap 'rm -rf -- "${workspace:?}"' EXIT
mkdir "$workspace/reports"
echo "==> Measuring the coverage of ${revision:0:12} for the baseline"
git clone --quiet --shared --no-checkout "$PWD" "$workspace/source"
git -C "$workspace/source" checkout --quiet --detach "$revision"
(
  cd "$workspace/source"
  export XQUIK_COVERAGE_DIR="$workspace/reports"
  scripts/collect-coverage
  scripts/collect-branches
)
go run ./cmd/coverage-gain -record "$revision" "$workspace/reports"
