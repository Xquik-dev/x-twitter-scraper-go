#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik contributors
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
cd "$(dirname "$0")/.."
requirements=$(mktemp "${TMPDIR:-/tmp}/xquik-signing-requirements.XXXXXX")
uv export --locked --python 3.14.7 --project tools/signing --no-emit-project --format requirements-txt --output-file "$requirements" >/dev/null
UV_PYTHON=3.14.7 uv tool run --from pip-audit==2.10.1 pip-audit --require-hashes --disable-pip -r "$requirements"
