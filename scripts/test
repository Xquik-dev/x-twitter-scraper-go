set -euo pipefail

cd "$(dirname "$0")/.."

source scripts/temp-paths
temp_path workspace -d "${TMPDIR:-/tmp}/xquik-test.XXXXXX"
export GOTMPDIR="$workspace"

echo "==> Running tests"
go test ./... "$@"
