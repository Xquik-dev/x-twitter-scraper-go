#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik contributors
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
cd "$(dirname "$0")/.."
readonly pinned=2.27.0
codeql="${XQUIK_CODEQL_BIN:-$HOME/.cache/xquik-codeql/$pinned/codeql/codeql}"
if [[ ! -x "$codeql" ]]; then
  codeql="$(command -v codeql || true)"
fi
if [[ -z "$codeql" ]]; then
  echo "CodeQL CLI is missing. Install CodeQL $pinned as CONTRIBUTING.md says, or set XQUIK_CODEQL_BIN." >&2
  exit 1
fi
found="$("$codeql" version --format=terse)"
if [[ "$found" != "$pinned" ]]; then
  echo "CodeQL $found found, but this check pins $pinned. Set XQUIK_CODEQL_BIN to a $pinned CLI." >&2
  exit 1
fi
report="$(mktemp -d "${TMPDIR:-/tmp}/xquik-codeql.XXXXXX")"
echo "CodeQL writes its reports to $report"
"$codeql" pack install codeql/no-code-comments
"$codeql" database create "$report/database" --language=go --build-mode=autobuild --source-root="$PWD" --threads=4
"$codeql" database analyze "$report/database" codeql/go-queries@1.6.10:codeql-suites/go-security-extended.qls codeql/no-code-comments --format=sarifv2.1.0 --output="$report/report.sarif" --threads=4
cat "$report/report.sarif"
go run ./cmd/codeql-security < "$report/report.sarif"
