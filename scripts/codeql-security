#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik contributors
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
cd "$(dirname "$0")/.."
readonly minimum=2.27.2
codeql="${XQUIK_CODEQL_BIN:-$(command -v codeql || true)}"
if [[ -z "$codeql" ]]; then
  echo "CodeQL CLI is missing. Install CodeQL $minimum or newer as CONTRIBUTING.md says, or set XQUIK_CODEQL_BIN." >&2
  exit 1
fi
found="$("$codeql" version --format=terse)"
if [[ "$(printf '%s\n' "$minimum" "$found" | sort -V | head -n 1)" != "$minimum" ]]; then
  echo "CodeQL $found is older than $minimum. Install CodeQL $minimum or newer as CONTRIBUTING.md says, or set XQUIK_CODEQL_BIN." >&2
  exit 1
fi
source scripts/temp-paths
temp_path report codeql
"$codeql" pack install codeql/no-code-comments
"$codeql" database create "$report/database" --language=go --build-mode=autobuild --source-root="$PWD" --threads=4
"$codeql" database analyze "$report/database" codeql/go-queries@1.6.12:codeql-suites/go-security-extended.qls codeql/no-code-comments --format=sarifv2.1.0 --output="$report/report.sarif" --threads=4
cat "$report/report.sarif"
go run ./cmd/codeql-security < "$report/report.sarif"
