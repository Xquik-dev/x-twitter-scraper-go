#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

cd "$(dirname "$0")/.."

source scripts/temp-paths
temp_path workspace -d "${TMPDIR:-/tmp}/xquik-go-coverage.XXXXXX"
coverage_profile="$workspace/coverage.out"
echo "Coverage profile: $coverage_profile"

echo "==> Collecting statement, function, and line coverage"
go test ./... -coverpkg=./... -coverprofile="$coverage_profile"
go run github.com/boumenot/gocover-cobertura@v1.5.0 -strict -by-files < "$coverage_profile" > "$workspace/coverage.xml"

if [ -n "${XQUIK_COVERAGE_DIR:-}" ]; then
  cp "$coverage_profile" "$XQUIK_COVERAGE_DIR/coverage.out"
  cp "$workspace/coverage.xml" "$XQUIK_COVERAGE_DIR/coverage.xml"
fi
