#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik contributors
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
cd "$(dirname "$0")/.."
report="$(mktemp "${TMPDIR:-/tmp}/xquik-gosec.XXXXXX")"
status=0
# gosec 2.29.0 pins a golang.org/x/tools that cannot read Go 1.27 export data.
# tools/gosec/go.mod builds the same gosec with a newer x/tools. Its folder is a
# separate module, so the tool stays out of go.mod and the published module.
go tool -modfile=tools/gosec/go.mod gosec -tests -nosec -enable-audit -track-suppressions -fmt=json ./... > "$report" || status=$?
cat "$report"
echo "Raw source scan exit: $status; retained report: $report"
if [ "$status" -gt 1 ]; then exit "$status"; fi
go run ./cmd/source-security < "$report"
