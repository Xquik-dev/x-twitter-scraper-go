#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik contributors
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/temp-paths
temp_path workspace gosec
# gosec 2.29.0 pins a golang.org/x/tools that cannot read Go 1.27 export data.
# tools/gosec/go.mod builds the same gosec with a newer x/tools.
# https://github.com/securego/gosec/issues/1774
go tool -modfile=tools/gosec/go.mod gosec -tests -nosec -enable-audit -track-suppressions -fmt=json ./...
