set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/temp-paths
temp_path workspace -d "${TMPDIR:-/tmp}/xquik-fuzz.XXXXXX"
export GOTMPDIR="$workspace"
echo "==> Fuzzing FuzzMarshalRoundTrip for ${FUZZ_TIME:-2m}"
go test ./internal/apiform -run '^$' -fuzz '^FuzzMarshalRoundTrip$' -fuzztime="${FUZZ_TIME:-2m}"
